<!DOCTYPE PATCH  SYSTEM "http://vvvv.org/versions/vvvv50beta42.dtd" >
   <PATCH nodename="C:\_work\dev\fluo\vvvv\FluoMod.v4p" systemname="FluoMod-" filename="gfx\Fluo\FluoMod-.v4p" scrollx="0" scrolly="-720">
   <BOUNDS type="Window" left="1310" top="3610" width="21720" height="11260">
   </BOUNDS>
   <INFO author="eps" description="Tempo-locked modulation, palette and activity mask for the Fluoddity particle system" tags="osc fluoddity tempo palette">
   </INFO>
   <PACK Name="addonpack" Version="42.0.0">
   </PACK>
   <NODE nodename="IOBox (String)" systemname="IOBox (String)" componentmode="InABox" id="1">
   <BOUNDS type="Box" left="9140" top="4730" width="6000" height="900">
   </BOUNDS>
   <BOUNDS type="Node" left="9140" top="4730" width="0" height="0">
   </BOUNDS>
   <PIN pinname="Input String" visible="0" slicecount="1" values="|||Tempo-locked modulation, palette and mask for Fluoddity.&amp;cr;&amp;lf;&amp;cr;&amp;lf;Sits alongside the Fluoddity- module and talks to the same OSC port. It does not touch the Texture or Params path -- Params still carries the base values, this adds movement on top of them.&amp;cr;&amp;lf;&amp;cr;&amp;lf;Tick, BeatBang and ||FULL AUTO|| are picked up from the show automatically. edgecol drives the particle palette. All modulation defaults to zero depth, so nothing changes until you dial it in.&amp;cr;&amp;lf;&amp;cr;&amp;lf;Depth/Source/Period/Lo/Hi are 12 slices each, in the same order as the Fluoddity- Params pin. See README.md.|||">
   </PIN>
   <PIN pinname="Output String" visible="0">
   </PIN>
   <PIN pinname="Show Grid" slicecount="1" values="0">
   </PIN>
   <PIN pinname="String Type" slicecount="1" values="MultiLine">
   </PIN>
   </NODE>
